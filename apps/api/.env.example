# The API connects as snappos_app, NEVER as the table owner. RLS does not apply
# to an owner, so pointing this at snappos_migrator silently disables every
# tenancy policy. The service refuses to start if it detects an owner role.
DATABASE_URL=postgres://snappos_app:dev_only_not_a_secret@localhost:5432/snappos

# At least 32 characters. Required in production; a random one is generated in
# development, which invalidates tokens on restart.
JWT_SECRET=

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

PORT=3000
RATE_LIMIT_MAX=300

# Only enable behind a proxy you control. Trusting it blindly lets a client
# spoof X-Forwarded-For and defeat per-IP rate limiting.
TRUST_PROXY=false

# Comma separated. Empty disables CORS entirely.
CORS_ORIGINS=

# Object storage for uploaded invoices (S3 API). MinIO in development
# (docker compose already runs it, credentials snappos/dev_only_not_a_secret);
# Cloudflare R2 in production, same API, just a different endpoint.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=snappos-invoices
S3_ACCESS_KEY_ID=snappos
S3_SECRET_ACCESS_KEY=dev_only_not_a_secret
# MinIO (and most non-AWS S3 implementations) need path-style addressing;
# AWS itself and R2 both also accept it, so this stays true everywhere.
S3_FORCE_PATH_STYLE=true

# AI-assisted invoice extraction (pdf/edi text extraction, and the matching
# cascade's last tier). Optional: csv upload and the barcode/vendor-sku/
# trigram matching tiers all work with these unset. Leaving either blank
# makes pdf/edi parsing throw a clear "not configured" error instead of
# silently doing nothing.
OPENAI_API_KEY=
# The model name is never hardcoded in code -- set whatever current model
# name your OpenAI account has access to.
OPENAI_MODEL=
