# The API connects as snappos_app, NEVER as the table owner. RLS does not apply
# to an owner, so pointing this at snappos_migrator silently disables every
# tenancy policy. The service refuses to start if it detects an owner role.
DATABASE_URL=postgres://snappos_app:dev_only_not_a_secret@localhost:5432/snappos

# At least 32 characters. Required in production; a random one is generated in
# development, which invalidates tokens on restart.
JWT_SECRET=

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

PORT=3000
RATE_LIMIT_MAX=300

# Only enable behind a proxy you control. Trusting it blindly lets a client
# spoof X-Forwarded-For and defeat per-IP rate limiting.
TRUST_PROXY=false

# Comma separated. Empty disables CORS entirely.
CORS_ORIGINS=
