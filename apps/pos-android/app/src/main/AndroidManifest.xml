<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Receipt printers and cash drawers. Declared here, used only through
         hardware-api adapters; checkout never touches them directly. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Voice search. Asked for the first time the microphone is tapped, never
         at launch, and never needed for anything else: a till that is never
         spoken to never asks. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- From Android 11 an app can only see the services it declares an
         interest in. Without this, SpeechRecognizer.isRecognitionAvailable
         answers false even with the Google app installed, and the microphone
         never appears. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".SnapPosApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnapPos"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- WorkManager's default initializer runs via androidx.startup, before
             Application.onCreate, so it would build a WorkManager with the
             stock factory and ignore the Hilt one entirely. The symptom is a
             NoSuchMethodException on every @HiltWorker at run time and nothing
             at compile time. Removing the initializer lets the Configuration
             this Application provides be the one that is used. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- windowSoftInputMode: the scan field sits at the top and the grid
             fills the rest, so there is nothing below the fold a resize would
             reveal, and adjustResize only squashed the product grid.
             stateAlwaysHidden keeps the on-screen keyboard down when the
             window takes focus; ScanField keeps it down when the field does,
             because a register is driven by a scanner. -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
