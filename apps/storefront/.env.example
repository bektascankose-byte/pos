# The SnapPOS API this website talks to. Server-side only: every call is made
# from Next.js server code, never from a shopper's browser, so none of these
# has a NEXT_PUBLIC_ prefix and none reaches client-side JavaScript.
API_BASE_URL=http://localhost:3000

# The key this website presents to the API. Issue one in the back office under
# Website -> Website keys; it is shown once. The value below is the development
# key the seed creates, and works only against a development database.
SHOP_API_KEY=shop_dev_only_not_a_secret

# Set to "true" behind HTTPS so cart and sign-in cookies get the Secure flag.
# Local development over plain http needs this off, or the browser silently
# drops the cookies.
COOKIE_SECURE=false
