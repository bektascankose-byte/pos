# The API this dashboard talks to. Server-side only -- never exposed to the
# browser (no NEXT_PUBLIC_ prefix), since every API call is made from Next.js
# server code, never from client-side JS. See lib/api.ts.
API_BASE_URL=http://localhost:3000

# Set to "true" behind HTTPS (staging/production) so session cookies get the
# Secure flag. Local dev over plain http needs this off, or the browser
# silently refuses to store the cookies at all.
COOKIE_SECURE=false
